---
import BrandIcon from "./BrandIcon.astro";
import {
  siCplusplus,
  siPython,
  siPhp,
  siJavascript,
  siTypescript,
  siOpenjdk,
  siKotlin,
  siDart,
  siFlutter,
  siJetpackcompose,
  siReact,
  siVuedotjs,
  siAstro,
  siDjango,
  siLaravel,
  siCss,
  siLatex,
  siGit,
  siDocker,
} from "simple-icons";
---

<!-- Skills Section -->
<section id="skills" class="skills-section section-padding">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="lang-en">Skills & Expertise</span>
        <span class="lang-nl">Vaardigheden</span>
      </h2>
    </div>

    <div class="skills-grid">
      <!-- Spoken Languages -->
      <div class="skill-category-card">
        <h3 class="skill-category-title">
          <i data-lucide="languages"></i>
          <span class="lang-en">Spoken Languages</span>
          <span class="lang-nl">Gesproken talen</span>
        </h3>
        <div class="skill-list">
          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name">
                <span class="lang-en">Dutch</span>
                <span class="lang-nl">Nederlands</span>
              </span>
              <span class="skill-percentage">95%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="95%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name">
                <span class="lang-en">English</span>
                <span class="lang-nl">Engels</span>
              </span>
              <span class="skill-percentage">95%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="95%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name">
                <span class="lang-en">German</span>
                <span class="lang-nl">Duits</span>
              </span>
              <span class="skill-percentage">80%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="80%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name">
                <span class="lang-en">French</span>
                <span class="lang-nl">Frans</span>
              </span>
              <span class="skill-percentage">40%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="40%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name">
                <span class="lang-en">Spanish</span>
                <span class="lang-nl">Spaans</span>
              </span>
              <span class="skill-percentage">30%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="30%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Programming Languages -->
      <div class="skill-category-card">
        <h3 class="skill-category-title">
          <i data-lucide="code-2"></i>
          <span class="lang-en">Programming Languages</span>
          <span class="lang-nl">Programmeertalen</span>
        </h3>
        <div class="skill-list">
          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siCplusplus} /></span>C++</span>
              <span class="skill-percentage">80%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="80%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siPython} /></span>Python</span>
              <span class="skill-percentage">70%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="70%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siPhp} /></span>PHP</span>
              <span class="skill-percentage">70%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="70%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siJavascript} /><BrandIcon icon={siTypescript} /></span>JavaScript / TypeScript</span>
              <span class="skill-percentage">65%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="65%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><i data-lucide="database"></i></span>SQL</span>
              <span class="skill-percentage">60%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="60%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siOpenjdk} /></span>Java</span>
              <span class="skill-percentage">60%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="60%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siKotlin} /></span>Kotlin</span>
              <span class="skill-percentage">50%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="50%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siDart} /></span>Dart</span>
              <span class="skill-percentage">40%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="40%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Other Skills -->
      <div class="skill-category-card">
        <h3 class="skill-category-title">
          <i data-lucide="layers"></i>
          <span class="lang-en">Other Skills</span>
          <span class="lang-nl">Overige vaardigheden</span>
        </h3>
        <div class="skill-list">
          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siReact} /><BrandIcon icon={siVuedotjs} /><BrandIcon icon={siAstro} /></span>Frontend (React, Vue, Astro)</span>
              <span class="skill-percentage">80%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="80%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siDjango} /><BrandIcon icon={siLaravel} /></span>Backend (Django, Laravel Nova)</span>
              <span class="skill-percentage">70%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="70%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siFlutter} /><BrandIcon icon={siJetpackcompose} /></span>Mobile (Flutter, Jetpack Compose)</span>
              <span class="skill-percentage">50%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="50%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siCss} /></span>CSS</span>
              <span class="skill-percentage">60%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="60%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siLatex} /></span>LaTeX</span>
              <span class="skill-percentage">80%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="80%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name">
                <span class="skill-icons">
                  <!-- Moneybird mask icon (moneybird.nl/favicons/icon.svg); not in simple-icons -->
                  <svg class="brand-icon brand-icon--wide" viewBox="0 150 1024 724" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M502.4 760c-204-15.8-270.2-127.6-288.7-205 0 0 40 11 92 18 0 0 14 2 14.3-1.8.6-7-117.4-41.8-174.5-139.7C101 355 98.2 281.8 98.2 281.8c119.6 23 193.2 52 569.6 42.7 116.6 0 168.6 24 168.6 167 0 99.6-43.6 266.4-334 268.4M1024 486c0-18.7-19.8-30.6-44.3-38.3l.5-.5-3.8-.5c-4-1.2-8-2.3-12-3.2-5.6-2-11.5-5.2-16-10-5-5.5-8-12.5-10-18.5C923 311.4 864 216.6 667.8 216.6H327c-11.6-.3-43-2-117-10.3-72-7.8-136.5-30.5-137-30.7L9.6 153 2 220c-1 8.2-21.6 197.4 99.8 293.5v1c-4.8 51 14.6 161.7 120 251.3 228.5 194.4 539 72.4 618.4-13C890 699 925.6 636 938 560c1.7-6.3 5-14 10.5-20 2.4-2.7 5.2-4.8 8.2-6.5 8-2 16-4.4 23.5-7.2 24.3-9 43.8-22 43.8-40.5M725.2 389c-26.4 0-44.2 16.4-44.2 46.6 0 28.2 17.8 44 44.2 44 26 0 44.8-16.8 44.8-44.5 0-30-15.8-46-44.8-46"/>
                  </svg>
                </span>
                <span class="lang-en">Accounting (Moneybird)</span>
                <span class="lang-nl">Boekhouding (Moneybird)</span>
              </span>
              <span class="skill-percentage">80%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="80%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siGit} /></span>Git</span>
              <span class="skill-percentage">70%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="70%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><BrandIcon icon={siDocker} /></span>Docker</span>
              <span class="skill-percentage">60%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="60%"></div>
            </div>
          </div>

          <div class="skill-item">
            <div class="skill-info">
              <span class="skill-name"><span class="skill-icons"><i data-lucide="image"></i></span>Photoshop</span>
              <span class="skill-percentage">70%</span>
            </div>
            <div class="skill-progress-bg">
              <div class="skill-progress-bar" data-level="70%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
