---
import { Image } from 'astro:assets';
import ruLogo from '../assets/images/logos/RU_logo.png';
import jpLogo from '../assets/images/logos/JP_Logo.png';
import thaliaLogo from '../assets/images/logos/Thalia_Logo.png';
import homecareLogo from '../assets/images/logos/Homecare_Logo.png';
import tccLogo from '../assets/images/logos/TCC_Logo.png';
import ahLogo from '../assets/images/logos/AH_Logo.png';
import webdevLogo from '../assets/images/logos/WebDev_Logo.png';
import avondaleLogo from '../assets/images/logos/Avondale_Logo.png';
---

<!-- Resume Section -->
<section id="resume" class="resume-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">
        <span class="lang-en">My Resume</span>
        <span class="lang-nl">Mijn CV</span>
      </h2>
      <span class="section-subtitle-line"></span>
    </div>

    <!-- Resume Tabs Navigation -->
    <div class="resume-tabs">
      <button class="resume-tab-btn active" id="tab-btn-experience">
        <i data-lucide="briefcase"></i>
        <span class="lang-en">Work Experience</span>
        <span class="lang-nl">Werkervaring</span>
      </button>
      <button class="resume-tab-btn" id="tab-btn-education">
        <i data-lucide="graduation-cap"></i>
        <span class="lang-en">Education</span>
        <span class="lang-nl">Opleiding</span>
      </button>
      <button class="resume-tab-btn" id="tab-btn-projects">
        <i data-lucide="folder-git-2"></i>
        <span class="lang-en">Projects</span>
        <span class="lang-nl">Projecten</span>
      </button>
    </div>

    <!-- Experience Tab Pane -->
    <div class="resume-tab-content active" id="tab-content-experience">
      <div class="timeline">
        <!-- IT Helpdesk -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={ruLogo}
              alt="Radboud University"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">
              <span class="lang-en">2026 - Present</span>
              <span class="lang-nl">2026 - Heden</span>
            </span>
            <h3 class="timeline-title">
              <span class="lang-en">IT Support Assistant</span>
              <span class="lang-nl">IT Support Assistent</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Radboud University</span>
              <span class="lang-nl">Radboud Universiteit</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Provide IT support by deploying and configuring workstations
                across campus and assisting users via the service desk.</span
              >
              <span class="lang-nl"
                >Verlenen van IT-ondersteuning door het uitrollen en
                configureren van werkplekken op de campus en het ondersteunen
                van gebruikers via de servicedesk.</span
              >
            </p>
          </div>
        </div>

        <!-- Nijper -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={jpLogo}
              alt="JP Activiteiten"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">
              <span class="lang-en">2026 - Present</span>
              <span class="lang-nl">2026 - Heden</span>
            </span>
            <h3 class="timeline-title">
              <span class="lang-en">Founder</span>
              <span class="lang-nl">Oprichter</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Nijper</span>
              <span class="lang-nl">Nijper</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Co-Founder of <a
                  href="https://nijper.nl"
                  target="_blank"
                  rel="noopener noreferrer">Nijper</a
                > web solutions.</span
              >
              <span class="lang-nl"
                >Co-Founder van <a
                  href="https://nijper.nl"
                  target="_blank"
                  rel="noopener noreferrer">Nijper</a
                > web solutions.</span
              >
            </p>
          </div>
        </div>

        <!-- JP Activiteiten -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={jpLogo}
              alt="JP Activiteiten"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2025 - 2026</span>
            <h3 class="timeline-title">
              <span class="lang-en">Software Engineer</span>
              <span class="lang-nl">Software Engineer</span>
            </h3>
            <h4 class="timeline-location">JP Activiteiten</h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Full-stack development for the web app <a
                  href="https://daariseenzaaltjevoor.nl"
                  target="_blank"
                  rel="noopener noreferrer">daariseenzaaltjevoor.nl</a
                >.</span
              >
              <span class="lang-nl"
                >Full-stack ontwikkeling voor de webapp <a
                  href="https://daariseenzaaltjevoor.nl"
                  target="_blank"
                  rel="noopener noreferrer">daariseenzaaltjevoor.nl</a
                >.</span
              >
            </p>
          </div>
        </div>

        <!-- Radboud TA -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={ruLogo}
              alt="Radboud University"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2024 - 2025</span>
            <h3 class="timeline-title">
              <span class="lang-en">Teaching Assistant</span>
              <span class="lang-nl">Student Assistent</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Radboud University</span>
              <span class="lang-nl">Radboud Universiteit</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Tutoring for the course Algorithms & Data Structures.</span
              >
              <span class="lang-nl"
                >Begeleiden van werkcolleges voor het vak Algorithms & Data
                Structures.</span
              >
            </p>
          </div>
        </div>

        <!-- Committee Work -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={thaliaLogo}
              alt="Study Association Thalia"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">
              <span class="lang-en">2021 - Present</span>
              <span class="lang-nl">2021 - Heden</span>
            </span>
            <h3 class="timeline-title">
              <span class="lang-en">Committee Work</span>
              <span class="lang-nl">Commissiewerk</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Study Association Thalia</span>
              <span class="lang-nl">Studievereniging Thalia</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Events Committee, Partner Committee, Lustrum Committee (Chair),
                and Audit Committee.</span
              >
              <span class="lang-nl"
                >Werk voor verschillende commissies, waaronder de
                Evenementencommissie, Partnercommissie, Lustrumcommissie
                (voorzitter) en Kascommissie en nog een aantal andere commissies
                .</span
              >
            </p>
          </div>
        </div>

        <!-- Treasurer Board Year -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={thaliaLogo}
              alt="Study Association Thalia"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2023 - 2024</span>
            <h3 class="timeline-title">
              <span class="lang-en">Board Year - Treasurer</span>
              <span class="lang-nl">Bestuursjaar: Penningmeester</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Study Association Thalia</span>
              <span class="lang-nl">Studievereniging Thalia</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Responsible for the association's finances as treasurer during
                the board year.</span
              >
              <span class="lang-nl"
                >Verantwoordelijk voor de financiën van een studievereniging met
                ongeveer 800 leden.</span
              >
            </p>
          </div>
        </div>

        <!-- Home care -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={homecareLogo}
              alt="Home Care"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2021 - 2023</span>
            <h3 class="timeline-title">
              <span class="lang-en">Home Care Support</span>
              <span class="lang-nl">Thuiszorg</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Private residence</span>
              <span class="lang-nl">Particuliere woning</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Household assistance for an individual with mobility
                challenges.</span
              >
              <span class="lang-nl"
                >Huishoudelijke ondersteuning voor een persoon met
                mobiliteitsbeperkingen.</span
              >
            </p>
          </div>
        </div>

        <!-- Private tutor -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={tccLogo}
              alt="Twents Carmel College"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2015 - 2019</span>
            <h3 class="timeline-title">
              <span class="lang-en">Private Tutor</span>
              <span class="lang-nl">Bijles docent</span>
            </h3>
            <h4 class="timeline-location">Twents Carmel College</h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Tutored scientific subjects including Physics, Chemistry, and
                Mathematics.</span
              >
              <span class="lang-nl"
                >Bijles gegeven in bètavakken zoals natuurkunde, scheikunde en
                wiskunde.</span
              >
            </p>
          </div>
        </div>

        <!-- Restocking -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={ahLogo}
              alt="Albert Heijn"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2016 - 2018</span>
            <h3 class="timeline-title">
              <span class="lang-en">Restocking</span>
              <span class="lang-nl">Vakkenvuller</span>
            </h3>
            <h4 class="timeline-location">Albert Heijn, Oldenzaal</h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Worked in store operations with restocking and coordination
                tasks.</span
              >
              <span class="lang-nl"
                >Werkzaam geweest in de winkel met vakkenvullen en coördinerende
                taken.</span
              >
            </p>
          </div>
        </div>

        <!-- Website design -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={webdevLogo}
              alt="Website Design"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2016</span>
            <h3 class="timeline-title">
              <span class="lang-en">Website Design</span>
              <span class="lang-nl">Websiteontwerp</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Massage practice Ayuda</span>
              <span class="lang-nl">Massagepraktijk Ayuda</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Designed the website for <a
                  href="https://www.massage-ayuda.nl"
                  target="_blank"
                  rel="noopener noreferrer">massage-ayuda.nl</a
                >.</span
              >
              <span class="lang-nl"
                >Simpele website ontworpen voor een kennis (<a
                  href="https://www.massage-ayuda.nl"
                  target="_blank"
                  rel="noopener noreferrer">massage-ayuda.nl</a
                >).</span
              >
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Education Tab Pane -->
    <div class="resume-tab-content" id="tab-content-education">
      <div class="timeline">
        <!-- RU CS Bachelor -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={ruLogo}
              alt="Radboud University"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2020 - 2026</span>
            <h3 class="timeline-title">
              <span class="lang-en">Bachelor Computing Science</span>
              <span class="lang-nl">Bachelor Computing Science</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Radboud University</span>
              <span class="lang-nl">Radboud Universiteit</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Specialisation tracks in Data Science and Cyber Security. Minor
                in Physics and minor in Business.</span
              >
              <span class="lang-nl"
                >Specialisatie tracks in Data Science en Cyber Security. Minor
                in Natuurkunde en minor in Bedrijfskunde.</span
              >
            </p>
          </div>
        </div>

        <!-- RU Physics Bachelor -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={ruLogo}
              alt="Radboud University"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2019 - 2020</span>
            <h3 class="timeline-title">
              <span class="lang-en">Bachelor Physics & Astronomy</span>
              <span class="lang-nl">Bachelor Natuur- en Sterrenkunde</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en">Radboud University</span>
              <span class="lang-nl">Radboud Universiteit</span>
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Started with a Physics degree before switching to Computing
                Science.</span
              >
              <span class="lang-nl"
                >Begonnen met een studie Natuurkunde voordat ik me volledig ben
                gaan richten op Informatica.</span
              >
            </p>
          </div>
        </div>

        <!-- Avondale College -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={avondaleLogo}
              alt="Avondale College"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2018</span>
            <h3 class="timeline-title">
              <span class="lang-en">International High School</span>
              <span class="lang-nl">Internationale Highschool</span>
            </h3>
            <h4 class="timeline-location">
              <span class="lang-en"
                >Avondale College, Auckland, New Zealand</span
              >
              <span class="lang-nl"
                >Avondale College, Auckland, Nieuw-Zeeland</span
              >
            </h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Completed part of my high school education abroad.</span
              >
              <span class="lang-nl"
                >Een deel van mijn middelbare schooltijd heb ik in het
                buitenland gevolgd.</span
              >
            </p>
          </div>
        </div>

        <!-- Twents Carmel College -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-logo">
            <Image
              src={tccLogo}
              alt="Twents Carmel College"
              width={32}
              height={32}
            />
          </div>
          <div class="timeline-info">
            <span class="timeline-date">2012 - 2019</span>
            <h3 class="timeline-title">
              <span class="lang-en">VWO Atheneum</span>
              <span class="lang-nl">VWO Atheneum</span>
            </h3>
            <h4 class="timeline-location">Twents Carmel College</h4>
            <p class="timeline-desc">
              <span class="lang-en"
                >Profile NT, with business economics as an additional course.</span
              >
              <span class="lang-nl"
                >Profiel Natuur & Techniek, met bedrijfseconomie als extra vak.</span
              >
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Projects Tab Pane -->
    <div class="resume-tab-content" id="tab-content-projects">
      <div class="projects-grid">
        <!-- Daar Is Een Zaaltje Voor -->
        <div class="project-card">
          <div class="project-card-header">
            <div class="project-folder-icon">
              <i data-lucide="folder"></i>
            </div>
            <div class="project-links">
              <a
                href="https://daariseenzaaltjevoor.nl"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                title="Live Website"
                aria-label="Live Website for Daar Is Een Zaaltje Voor"
              >
                <i data-lucide="external-link"></i>
              </a>
            </div>
          </div>
          <div class="project-card-content">
            <h3 class="project-title">Daar Is Een Zaaltje Voor</h3>
            <p class="project-desc">
              <span class="lang-en"
                >Full-stack web application designed for renting and hosting
                community rooms and events. Built during my work at JP
                Activiteiten.</span
              >
              <span class="lang-nl"
                >Full-stack webapplicatie voor het zoeken en huren van zaaltjes
                en evenementenlocaties. Ontwikkeld tijdens mijn werk bij JP
                Activiteiten.</span
              >
            </p>
          </div>
          <div class="project-card-footer">
            <span class="project-tech">Vue.js</span>
            <span class="project-tech">Laravel Nova</span>
            <span class="project-tech">MySQL</span>
          </div>
        </div>

        <!-- CV Matching Platform -->
        <div class="project-card">
          <div class="project-card-header">
            <div class="project-folder-icon">
              <i data-lucide="folder"></i>
            </div>
          </div>
          <div class="project-card-content">
            <h3 class="project-title">CV Matching Platform</h3>
            <p class="project-desc">
              <span class="lang-en"
                >A web application for automatically processing and matching CVs
                to job vacancies. Developed in a team of 6 students for a
                company as part of the Software Engineering course at Radboud
                University.</span
              >
              <span class="lang-nl"
                >Een webapplicatie voor het automatisch verwerken en matchen van
                CV's aan vacatures. Ontwikkeld in een team van 6 studenten voor
                een een bedrijf naar aanleiding van het vak Software Engineering
                op de Radboud Universiteit.</span
              >
            </p>
          </div>
          <div class="project-card-footer">
            <span class="project-tech">React</span>
            <span class="project-tech">Django</span>
            <span class="project-tech">Docker</span>
            <span class="project-tech">Elasticsearch</span>
            <span class="project-tech">Google OAuth</span>
          </div>
        </div>

        <!-- AnyPennie -->
        <div class="project-card">
          <div class="project-card-header">
            <div class="project-folder-icon">
              <i data-lucide="folder"></i>
            </div>
            <div class="project-links">
              <a
                href="https://github.com/AnyPennie-B-V/anypennie.nl.git"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                title="GitHub Repository"
                aria-label="GitHub Repository for AnyPennie"
              >
                <i data-lucide="github"></i>
              </a>
              <a
                href="https://anypennie.nl"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                title="Live Website"
                aria-label="Live Website for AnyPennie"
              >
                <i data-lucide="external-link"></i>
              </a>
            </div>
          </div>
          <div class="project-card-content">
            <h3 class="project-title">AnyPennie</h3>
            <p class="project-desc">
              <span class="lang-en"
                >An interactive dashboard and ledger system designed for
                tracking Anytimers (Any Pennies) for study association
                treasurers. It provides a shared, transparent, and auditable
                record of who still has anys left to take.</span
              >
              <span class="lang-nl"
                >Een interactief dashboard en ledgersysteem, ontworpen voor het
                bijhouden van Anytimers (Any Pennies) voor penningmeesters van
                studieverenigingen. Het biedt een gedeeld, transparant en
                controleerbaar overzicht van wie nog Anys te goed heeft.</span
              >
            </p>
          </div>
          <div class="project-card-footer">
            <span class="project-tech">Vercel</span>
            <span class="project-tech">Redis </span>
          </div>
        </div>

        <!-- Nijper -->
        <div class="project-card">
          <div class="project-card-header">
            <div class="project-folder-icon">
              <i data-lucide="folder"></i>
            </div>
            <div class="project-links">
              <a
                href="https://nijper.nl"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                title="Live Website"
                aria-label="Live Website for Nijper"
              >
                <i data-lucide="external-link"></i>
              </a>
            </div>
          </div>
          <div class="project-card-content">
            <h3 class="project-title">Nijper</h3>
            <p class="project-desc">
              <span class="lang-en"
                >Site for a web solutions startup focusing on custom web design
                and development for local businesses, cafes, and festivals.
                Built and optimized for local SEO.</span
              >
              <span class="lang-nl"
                >Site van een webdesignbureau dat zich richt op het ontwerpen en
                ontwikkelen van websites op maat voor lokale ondernemingen,
                cafés en festivals. Gebouwd en geoptimaliseerd voor lokale SEO.</span
              >
            </p>
          </div>
          <div class="project-card-footer">
            <span class="project-tech">SEO</span>
          </div>
        </div>

        <!-- Outer Wilds Checklist -->
        <div class="project-card">
          <div class="project-card-header">
            <div class="project-folder-icon">
              <i data-lucide="folder"></i>
            </div>
            <div class="project-links">
              <a
                href="https://github.com/BigRoelof/OuterWilds.git"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                title="GitHub Repository"
                aria-label="GitHub Repository for Outer Wilds Checklist"
              >
                <i data-lucide="github"></i>
              </a>
            </div>
          </div>
          <div class="project-card-content">
            <h3 class="project-title">Outer Wilds Checklist</h3>
            <p class="project-desc">
              <span class="lang-en"
                >An interactive progress tracker and ship log checklist for the
                Outer Wilds game. Helps players keep track of locations, logs,
                and achievements.</span
              >
              <span class="lang-nl"
                >Een interactieve voortgangstracker en logboek-checklist voor
                het spel Outer Wilds. Helpt spelers bij het bijhouden van
                bezochte locaties en logs.</span
